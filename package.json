{
  "name": "scholia",
  "version": "0.2.2",
  "private": true,
  "description": "Select text, math, or a screen region and get a contextual AI explanation.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/heaps0rt/scholia.git"
  },
  "homepage": "https://github.com/heaps0rt/scholia#readme",
  "bugs": {
    "url": "https://github.com/heaps0rt/scholia/issues"
  },
  "keywords": [
    "chrome-extension",
    "study",
    "ai",
    "pdf",
    "math"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/build-chrome.mjs",
    "build:macos": "zsh scripts/build-macos-app.sh",
    "setup:macos-signing": "zsh scripts/setup-macos-signing.sh",
    "install:macos": "zsh scripts/install-macos-app.sh",
    "update:macos": "zsh scripts/install-macos-app.sh --launch",
    "run:macos": "swift run --package-path apps/macos ScholiaMac",
    "package:chrome": "node scripts/package-chrome.mjs",
    "check": "node scripts/check-source.mjs && node scripts/check-macos-syntax.mjs && npm test",
    "check:dist": "node scripts/check-chrome-dist.mjs",
    "smoke:chromium:recursion": "node scripts/smoke-chromium-panel-recursion.mjs",
    "smoke:macos:workspace": "zsh scripts/smoke-macos-workspace.sh",
    "smoke:macos:paper": "zsh scripts/smoke-macos-paper.sh",
    "smoke:macos:paper:ui": "zsh scripts/smoke-macos-paper-ui.sh",
    "smoke:macos:paper:live": "zsh scripts/smoke-macos-paper-live.sh",
    "smoke:macos:course-ui": "zsh scripts/smoke-macos-workspace.sh --course-ui-only",
    "test": "node --test",
    "benchmark:search": "node scripts/benchmark-workspace-search.mjs",
    "benchmark:search:semantic": "node scripts/benchmark-semantic-search.mjs",
    "benchmark:search:native": "bash scripts/benchmark-search-native.sh",
    "test:search:native": "bash scripts/benchmark-search-native.sh --sanitize",
    "smoke:macos:search": "zsh scripts/smoke-macos-search.sh",
    "smoke:macos:files": "zsh scripts/smoke-macos-files.sh",
    "smoke:chromium:search": "npm run build:web && node scripts/smoke-workspace-search.mjs",
    "smoke:chromium:exams": "npm run build:web && node scripts/smoke-exam-planner.mjs",
    "smoke:chromium:courses": "npm run build:web && node scripts/smoke-course-documents.mjs",
    "smoke:chromium:performance": "npm run build:web && node scripts/smoke-ui-performance.mjs",
    "smoke:macos:courses": "zsh scripts/smoke-macos-workspace.sh --course-documents-only",
    "smoke:chromium:studentweb": "node scripts/smoke-studentweb-extraction.mjs",
    "smoke:chromium:studentweb-results": "node scripts/smoke-studentweb-results.mjs",
    "check:studentweb:live": "node scripts/check-studentweb-live.mjs",
    "import:study-plans": "node scripts/import-ntnu-study-plans.mjs",
    "smoke:macos:studentweb-results": "npm run build:web && zsh scripts/smoke-macos-studentweb-results.sh",
    "smoke:macos:exams": "npm run build:web && zsh scripts/smoke-macos-exams.sh",
    "bridge:codex": "node scripts/codex-bridge.mjs",
    "bridge:claude": "node scripts/claude-code-bridge.mjs",
    "bridge:install:codex": "node scripts/install-codex-handler.mjs",
    "bridge:install:claude": "node scripts/install-claude-handler.mjs",
    "bridge:install:opencode": "node scripts/install-opencode-handler.mjs",
    "build:web": "node scripts/build-study-web.mjs",
    "start:web": "node apps/server/server.js",
    "web:user": "node scripts/web-user.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.1",
    "@napi-rs/canvas": "^1.0.9",
    "@tesseract.js-data/eng": "1.0.0",
    "@tesseract.js-data/nor": "1.0.0",
    "highlight.js": "11.11.1",
    "katex": "0.16.47",
    "linkedom": "^0.18.12",
    "markdown-it": "15.0.0",
    "pdfjs-dist": "4.10.38",
    "tesseract.js": "7.0.0",
    "usearch": "2.26.4"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "prettier": "^3.6.2"
  }
}
